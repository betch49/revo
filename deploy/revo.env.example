# Copy to ~/revo/revo.env (chmod 600) and fill in.

# Hash of your admin password. Create it with:  ~/revo/bin/revo hash-password
# Keep the single quotes: the hash contains $ signs.
REVO_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$REPLACE_ME'

# Where the app listens. Infomaniak Cloud Server (HAProxy): 0.0.0.0:4000 (ports 4000–4009).
# VPS behind Caddy: 127.0.0.1:4000.
REVO_BIND=0.0.0.0:4000

# Database and uploaded images. Defaults to ./data, i.e. ~/revo/data with the
# provided systemd unit. Back this folder up.
# REVO_DATA_DIR=/absolute/path/to/data

REVO_PUBLIC_URL=https://review.betch.ch
REVO_MAX_UPLOAD_MB=60
RUST_LOG=info
