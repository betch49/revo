# Fail-fast proxy in front of Ollama on the main PC.
#
# When the PC is off its address often just goes silent instead of refusing
# connections, and LiteLLM would wait out the full request timeout before
# falling back. Here the *connect* gives up after 3s (-> 504, LiteLLM moves
# on to Infomaniak), while a running generation may take up to 10 minutes.

server {
    listen 11434;

    # Resolve at request time so the router starts even while the PC is off
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $ollama ${OLLAMA_UPSTREAM};

    location / {
        proxy_pass http://$ollama;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
        proxy_buffering off;            # stream tokens as they arrive
        proxy_request_buffering off;
    }
}
