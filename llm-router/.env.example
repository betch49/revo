# Copy to .env and fill in. Never commit .env.

# Key your apps use to call the router (any long random string: openssl rand -hex 24)
LITELLM_MASTER_KEY=sk-change-me

# Main PC running Ollama (IP:port is safest; Ollama must listen on the LAN, OLLAMA_HOST=0.0.0.0)
OLLAMA_UPSTREAM=192.168.1.50:11434
# Ollama model the 4090 serves for the "chat" model (as shown by `ollama list`)
OLLAMA_MODEL=qwen3:32b

# Infomaniak AI Tools: product id from the Manager (AI Tools), token with the "ai_tools" scope
INFOMANIAK_API_BASE=https://api.infomaniak.com/2/ai/PRODUCT_ID/openai/v1
INFOMANIAK_AI_TOKEN=
INFOMANIAK_MODEL=mistralai/Ministral-3-14B-Instruct-2512
